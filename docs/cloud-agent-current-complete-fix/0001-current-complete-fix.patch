+
+export function HealthBrandMark({size = 48, className = ''}: HealthMarkProps) {
+  const leafSize = Math.round(size * 0.42)
+
+  return (
+    <div
+      className={`relative flex items-center justify-center ${className}`}
+      style={{width: `${size}px`, height: `${size}px`}}
